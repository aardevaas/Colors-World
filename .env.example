# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Supabase → your project → Project Settings → API
# "Project URL"
SUPABASE_URL=

# "service_role" key (NOT the "anon" / "public" key — this one bypasses RLS
# and must only ever be read server-side; see src/lib/supabase/client.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
# Free tier. Optional: Library's vibe search works without this — it falls
# back to an offline keyword-based engine (see src/lib/spectrum/vibe-search.ts)
# whenever this is unset, rate-limited, or unreachable. Read server-side
# only (src/app/actions/vibe-search.ts) — deliberately NOT prefixed
# NEXT_PUBLIC_, since that prefix ships a var into the client bundle.
GEMINI_API_KEY=

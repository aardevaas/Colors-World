# ─── Supabase ────────────────────────────────────────────────────────────────
# Both pairs are required. The NEXT_PUBLIC_ ones are read by the BROWSER client
# (src/lib/supabase/client.ts); without them a fresh clone builds but fails at
# runtime the moment any room touches the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never exposed to the browser. Used by server actions,
# route handlers and the scripts in scripts/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
# Powers /library's vibe search ("ocean at dusk"). The room degrades to its
# normal browsing feed without it, so this is optional for local development.
GEMINI_API_KEY=
